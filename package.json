{
  "name": "art-supabase-pro",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "types": "./src/types/platform-runtime.d.ts",
  "files": [
    ".auto-import.json",
    ".env",
    ".env.development",
    ".env.production",
    "src",
    "public"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "modules:pull": "tsx scripts/manage-modules.ts pull",
    "modules:update": "tsx scripts/manage-modules.ts update",
    "modules:install": "tsx scripts/manage-modules.ts install",
    "modules:check": "tsx scripts/manage-modules.ts check",
    "modules:build": "tsx scripts/manage-modules.ts build",
    "modules:setup": "tsx scripts/manage-modules.ts setup",
    "build:analyze": "tsx scripts/analyze-build.ts",
    "bundle:check": "tsx scripts/check-bundle-budget.ts",
    "database:security:audit": "tsx scripts/audit-database-security.ts",
    "permissions:audit": "tsx scripts/audit-business-permissions.ts",
    "snapshot:ai": "tsx scripts/generate-ai-project-snapshot.ts",
    "snapshot:check": "tsx scripts/generate-ai-project-snapshot.ts --check",
    "ui:audit": "tsx scripts/ui-audit.ts",
    "serve": "tsx scripts/serve-built-app.ts",
    "lint": "eslint \"src/**/*.{js,mjs,cjs,ts,tsx,vue}\" \"scripts/**/*.{js,mjs,cjs,ts,tsx}\" \"tests/**/*.{js,mjs,cjs,ts,tsx}\" \"*.{js,mjs,cjs,ts}\"",
    "typecheck": "vue-tsc --noEmit --pretty false",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage \"--test-coverage-include=src/**/*.ts\" \"--test-coverage-include=supabase/functions/_shared/*.ts\" \"--test-coverage-include=scripts/*.ts\" --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=80 tests/unit/*.test.ts",
    "test:db": "supabase db query --linked --file supabase/tests/workflow_engine_test.sql",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test tests/e2e/auth-pages.accessibility.spec.ts --project=public-desktop-1440 --project=public-mobile-390",
    "test:e2e:vms-module": "playwright test tests/e2e/vms-module-host.spec.ts --project=desktop-1440",
    "test:e2e:critical": "playwright test tests/e2e/critical-business-flows.spec.ts --project=desktop-1440 --project=mobile-390 && playwright test tests/e2e/ai-configuration-inheritance.smoke.spec.ts --project=desktop-1440",
    "test:e2e:core": "playwright test tests/e2e/core-pages.visual.spec.ts --project=desktop-1440 --project=mobile-390",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "check:fast": "pnpm ui:audit && pnpm permissions:audit && pnpm database:security:audit && pnpm typecheck && pnpm lint && pnpm test:unit",
    "check": "pnpm check:fast && pnpm lint:stylelint",
    "check:ci": "pnpm modules:check && pnpm modules:build && pnpm ui:audit && pnpm typecheck && pnpm lint && pnpm lint:stylelint && pnpm test:coverage && pnpm snapshot:check && pnpm build && pnpm bundle:check && pnpm test:e2e:auth && pnpm test:e2e:critical && pnpm test:e2e:core",
    "fix": "pnpm lint --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint \"src/**/*.{css,scss,vue}\"",
    "lint:stylelint:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "lint:lint-staged": "lint-staged",
    "git-hooks:install": "husky",
    "commit": "git-cz",
    "clean:dev": "tsx scripts/clean-dev.ts"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json,jsonc}": [
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{html,htm}": [
      "prettier --write"
    ],
    "*.{scss,css,less}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ],
    "*.{yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@file-viewer/preset-all": "2.1.28",
    "@file-viewer/vue3": "2.1.28",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@iconify/vue": "^5.0.1",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.3.1",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "@vue/reactivity": "^3.5.38",
    "@vueuse/core": "^14.3.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "next",
    "axios": "^1.18.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.2",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.10.0",
    "lodash-es": "^4.18.1",
    "mitt": "^3.0.1",
    "monaco-editor": "0.55.1",
    "monaco-sql-languages": "^1.1.0",
    "node-sql-parser": "^5.4.0",
    "nprogress": "^0.2.0",
    "ohash": "^2.0.11",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.3.0",
    "qrcode.vue": "^3.10.0",
    "sql-formatter": "^15.8.2",
    "tailwindcss": "^4.3.1",
    "vue": "^3.5.38",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "xgplayer": "^3.0.24",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^10.0.1",
    "@file-viewer/vite-plugin": "2.1.28",
    "@playwright/test": "^1.62.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.38",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "husky": "^9.1.5",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.101.0",
    "stylelint": "^17.13.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "8.1.1",
    "terser": "^5.48.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.1.3",
    "vue-demi": "^0.14.9",
    "vue-eslint-parser": "10.4.1",
    "vue-img-cutter": "^3.1.1",
    "vue-tsc": "~3.3.5"
  },
  "description": "Art Supabase Pro 是一个基于 Vue 3、TypeScript、Element Plus、Supabase 和 AI SQL 助手的企业级中后台应用模板，内置 RBAC 权限、SQL 工作台、AI 写 SQL、车辆管理系统、TMS 运输管理系统和司机端相关能力。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/wangyanghub/art-supabase-pro.git"
  },
  "keywords": [
    "supabase",
    "vue3",
    "element-plus",
    "admin-template",
    "admin-dashboard",
    "ai-sql",
    "sql-assistant",
    "postgresql",
    "rbac",
    "tms",
    "vehicle-management",
    "fleet-management",
    "typescript",
    "vite"
  ],
  "author": "",
  "license": "ISC"
}
